</style>

<script>
  import {
    calculateTextStats,
    applyCaseTransform,
    copyTextToClipboard,
    FONT_VARIANTS,
    PREVIEW_THEMES,
    SAMPLE_TEXTS,
    type FontVariantKey,
    type CaseTransform
  } from './logic';

  class InstagramSansTool extends HTMLElement {
    private textInput: HTMLTextAreaElement | null = null;
    private statChars: HTMLElement | null = null;
    private statWords: HTMLElement | null = null;
    private statLines: HTMLElement | null = null;
    private statEmojis: HTMLElement | null = null;

    private fontSizeSlider: HTMLInputElement | null = null;
    private fontSizeVal: HTMLElement | null = null;
    private letterSpacingSlider: HTMLInputElement | null = null;
    private letterSpacingVal: HTMLElement | null = null;
    private lineHeightSlider: HTMLInputElement | null = null;
    private lineHeightVal: HTMLElement | null = null;

    private selectedVariantName: HTMLElement | null = null;
    private renderedTextContent: HTMLElement | null = null;
    private storyRenderedText: HTMLElement | null = null;
    private canvasTextWrapper: HTMLElement | null = null;
    private storyTextWrapper: HTMLElement | null = null;
    private typographyCanvas: HTMLElement | null = null;
    private storyBodyCanvas: HTMLElement | null = null;

    private copyBtn: HTMLButtonElement | null = null;
    private copyBtnText: HTMLElement | null = null;

    private currentVariant: FontVariantKey = 'regular';
    private currentCase: CaseTransform = 'none';
    private currentAlign: string = 'left';
    private currentSticker: string = 'none';
    private currentThemeId: string = 'dark';
    private sampleIndex: number = 0;

    connectedCallback() {
      this.initElements();
      this.bindEvents();
      this.updateAll();
    }

    private initElements() {
      this.textInput = this.querySelector('#ig-text-input');
      this.statChars = this.querySelector('#stat-chars');
      this.statWords = this.querySelector('#stat-words');
      this.statLines = this.querySelector('#stat-lines');
      this.statEmojis = this.querySelector('#stat-emojis');

      this.fontSizeSlider = this.querySelector('#font-size-slider');
      this.fontSizeVal = this.querySelector('#font-size-val');
      this.letterSpacingSlider = this.querySelector('#letter-spacing-slider');
      this.letterSpacingVal = this.querySelector('#letter-spacing-val');
      this.lineHeightSlider = this.querySelector('#line-height-slider');
      this.lineHeightVal = this.querySelector('#line-height-val');

      this.selectedVariantName = this.querySelector('#selected-variant-name');
      this.renderedTextContent = this.querySelector('#rendered-text-content');
      this.storyRenderedText = this.querySelector('#story-rendered-text');
      this.canvasTextWrapper = this.querySelector('#canvas-text-wrapper');
      this.storyTextWrapper = this.querySelector('#story-text-wrapper');
      this.typographyCanvas = this.querySelector('#typography-canvas');
      this.storyBodyCanvas = this.querySelector('#story-body-canvas');

      this.copyBtn = this.querySelector('#copy-btn');
      this.copyBtnText = this.querySelector('.copy-btn-text');
    }

    private bindEvents() {
      // Input typing & stats update
      this.textInput?.addEventListener('input', () => this.updateAll());

      // Load sample button
      const loadSampleBtn = this.querySelector('[data-action="load-sample"]');
      loadSampleBtn?.addEventListener('click', () => {
        this.sampleIndex = (this.sampleIndex + 1) % SAMPLE_TEXTS.length;
        if (this.textInput) {
          this.textInput.value = SAMPLE_TEXTS[this.sampleIndex];
          this.updateAll();
        }
      });

      // Clear button
      const clearBtn = this.querySelector('[data-action="clear"]');
      clearBtn?.addEventListener('click', () => {
        if (this.textInput) {
          this.textInput.value = '';
          this.textInput.focus();
          this.updateAll();
        }
      });

      // Reset controls
      const resetBtn = this.querySelector('[data-action="reset-controls"]');
      resetBtn?.addEventListener('click', () => this.resetControls());

      // Case buttons
      const caseButtons = this.querySelectorAll<HTMLButtonElement>('[data-case]');
      caseButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          caseButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          this.currentCase = (btn.getAttribute('data-case') as CaseTransform) || 'none';
          this.updateRenderedText();
        });
      });

      // Font Variant buttons
      const variantButtons = this.querySelectorAll<HTMLButtonElement>('[data-variant]');
      variantButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          variantButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const variantKey = (btn.getAttribute('data-variant') as FontVariantKey) || 'regular';
          this.currentVariant = variantKey;
          if (this.selectedVariantName) {
            this.selectedVariantName.textContent = FONT_VARIANTS[variantKey]?.name.replace('Instagram Sans ', '') || 'Regular';
          }
          this.updateFontVariantClasses();
        });
      });

      // Font Size Slider & Quick Presets
      this.fontSizeSlider?.addEventListener('input', () => {
        const val = this.fontSizeSlider?.value || '28';
        if (this.fontSizeVal) this.fontSizeVal.textContent = `${val}px`;
        this.updatePresetButtons(val);
        this.applyTypographyStyles();
      });

      const presetButtons = this.querySelectorAll<HTMLButtonElement>('[data-size]');
      presetButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const size = btn.getAttribute('data-size') || '28';
          if (this.fontSizeSlider) this.fontSizeSlider.value = size;
          if (this.fontSizeVal) this.fontSizeVal.textContent = `${size}px`;
          this.updatePresetButtons(size);
          this.applyTypographyStyles();
        });
      });

      // Letter Spacing Slider
      this.letterSpacingSlider?.addEventListener('input', () => {
        const val = parseFloat(this.letterSpacingSlider?.value || '0');
        if (this.letterSpacingVal) this.letterSpacingVal.textContent = `${val >= 0 ? '+' : ''}${val.toFixed(2)}em`;
        this.applyTypographyStyles();
      });

      // Line Height Slider
      this.lineHeightSlider?.addEventListener('input', () => {
        const val = parseFloat(this.lineHeightSlider?.value || '1.4');
        if (this.lineHeightVal) this.lineHeightVal.textContent = val.toFixed(2);
        this.applyTypographyStyles();
      });

      // Text Alignment Buttons
      const alignButtons = this.querySelectorAll<HTMLButtonElement>('[data-align]');
      alignButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          alignButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          this.currentAlign = btn.getAttribute('data-align') || 'left';
          this.applyTypographyStyles();
        });
      });

      // Story Sticker Pill Toggle
      const stickerButtons = this.querySelectorAll<HTMLButtonElement>('[data-sticker]');
      stickerButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          stickerButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          this.currentSticker = btn.getAttribute('data-sticker') || 'none';
          this.updateStickerPillClasses();
        });
      });

      // Theme Picker buttons
      const themeButtons = this.querySelectorAll<HTMLButtonElement>('[data-theme-id]');
      themeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          themeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          this.currentThemeId = btn.getAttribute('data-theme-id') || 'dark';
          this.applyThemeClasses();
        });
      });

      // View Mode Tabs (Canvas vs Story Simulator)
      const tabButtons = this.querySelectorAll<HTMLButtonElement>('[data-view]');
      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          tabButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const view = btn.getAttribute('data-view');
          const canvasView = this.querySelector('#canvas-view-container');
          const storyView = this.querySelector('#story-view-container');
          if (view === 'story') {
            canvasView?.classList.remove('active');
            storyView?.classList.add('active');
          } else {
            storyView?.classList.remove('active');
            canvasView?.classList.add('active');
          }
        });
      });

      // Copy Text Action
      this.copyBtn?.addEventListener('click', () => this.handleCopy());
    }

    private updateAll() {
      this.updateStats();
      this.updateRenderedText();
      this.updateFontVariantClasses();
      this.applyTypographyStyles();
    }

    private updateStats() {
      const rawText = this.textInput?.value || '';
      const stats = calculateTextStats(rawText);
      if (this.statChars) this.statChars.textContent = String(stats.characters);
      if (this.statWords) this.statWords.textContent = String(stats.words);
      if (this.statLines) this.statLines.textContent = String(stats.lines);
      if (this.statEmojis) this.statEmojis.textContent = String(stats.emojis);
    }

    private updateRenderedText() {
      const rawText = this.textInput?.value || '';
      const displayContent = rawText || 'Type or paste your text to preview...';
      const transformed = applyCaseTransform(displayContent, this.currentCase);

      if (this.renderedTextContent) {
        this.renderedTextContent.textContent = transformed;
      }
      if (this.storyRenderedText) {
        this.storyRenderedText.textContent = transformed;
      }
    }

    private updateFontVariantClasses() {
      const variant = FONT_VARIANTS[this.currentVariant];
      const allVariantClasses = Object.values(FONT_VARIANTS).map(v => v.cssClass);

      if (this.typographyCanvas) {
        allVariantClasses.forEach(cls => this.typographyCanvas?.classList.remove(cls));
        this.typographyCanvas.classList.add(variant.cssClass);
      }

      if (this.storyTextWrapper) {
        allVariantClasses.forEach(cls => this.storyTextWrapper?.classList.remove(cls));
        this.storyTextWrapper.classList.add(variant.cssClass);
      }
    }

    private applyTypographyStyles() {
      const fontSize = `${this.fontSizeSlider?.value || 28}px`;
      const letterSpacing = `${this.letterSpacingSlider?.value || 0}em`;
      const lineHeight = `${this.lineHeightSlider?.value || 1.4}`;
      const textAlign = this.currentAlign;

      if (this.renderedTextContent) {
        this.renderedTextContent.style.fontSize = fontSize;
        this.renderedTextContent.style.letterSpacing = letterSpacing;
        this.renderedTextContent.style.lineHeight = lineHeight;
        this.renderedTextContent.style.textAlign = textAlign;
      }

      if (this.storyRenderedText) {
        // Slightly scaled down font size for the simulated phone mockup viewport
        const numericSize = parseInt(this.fontSizeSlider?.value || '28', 10);
        const storySize = Math.max(14, Math.min(36, Math.round(numericSize * 0.8)));
        this.storyRenderedText.style.fontSize = `${storySize}px`;
        this.storyRenderedText.style.letterSpacing = letterSpacing;
        this.storyRenderedText.style.lineHeight = lineHeight;
        this.storyRenderedText.style.textAlign = textAlign;
      }
    }

    private updateStickerPillClasses() {
      const allStickerClasses = ['sticker-none', 'sticker-dark-pill', 'sticker-white-pill'];
      const targetClass = `sticker-${this.currentSticker}`;

      if (this.canvasTextWrapper) {
        allStickerClasses.forEach(c => this.canvasTextWrapper?.classList.remove(c));
        this.canvasTextWrapper.classList.add(targetClass);
      }

      if (this.storyTextWrapper) {
        allStickerClasses.forEach(c => this.storyTextWrapper?.classList.remove(c));
        this.storyTextWrapper.classList.add(targetClass);
      }
    }

    private applyThemeClasses() {
      const allThemeClasses = PREVIEW_THEMES.map(t => `theme-${t.id}`);
      const targetThemeClass = `theme-${this.currentThemeId}`;

      if (this.typographyCanvas) {
        allThemeClasses.forEach(c => this.typographyCanvas?.classList.remove(c));
        this.typographyCanvas.classList.add(targetThemeClass);
      }

      if (this.storyBodyCanvas) {
        allThemeClasses.forEach(c => this.storyBodyCanvas?.classList.remove(c));
        this.storyBodyCanvas.classList.add(targetThemeClass);
      }
    }

    private updatePresetButtons(currentSize: string) {
      const presetButtons = this.querySelectorAll<HTMLButtonElement>('[data-size]');
      presetButtons.forEach(btn => {
        if (btn.getAttribute('data-size') === currentSize) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    private resetControls() {
      this.currentVariant = 'regular';
      this.currentCase = 'none';
      this.currentAlign = 'left';
      this.currentSticker = 'none';
      this.currentThemeId = 'dark';

      if (this.fontSizeSlider) this.fontSizeSlider.value = '28';
      if (this.fontSizeVal) this.fontSizeVal.textContent = '28px';
      if (this.letterSpacingSlider) this.letterSpacingSlider.value = '0';
      if (this.letterSpacingVal) this.letterSpacingVal.textContent = '0.00em';
      if (this.lineHeightSlider) this.lineHeightSlider.value = '1.4';
      if (this.lineHeightVal) this.lineHeightVal.textContent = '1.40';
      if (this.selectedVariantName) this.selectedVariantName.textContent = 'Regular';

      this.querySelectorAll<HTMLButtonElement>('[data-variant]').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-variant') === 'regular');
      });
      this.querySelectorAll<HTMLButtonElement>('[data-case]').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-case') === 'none');
      });
      this.querySelectorAll<HTMLButtonElement>('[data-align]').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-align') === 'left');
      });
      this.querySelectorAll<HTMLButtonElement>('[data-sticker]').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-sticker') === 'none');
      });
      this.querySelectorAll<HTMLButtonElement>('[data-theme-id]').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-theme-id') === 'dark');
      });

      this.updatePresetButtons('28');
      this.updateFontVariantClasses();
      this.updateStickerPillClasses();
      this.applyThemeClasses();
      this.applyTypographyStyles();
      this.updateRenderedText();
    }

    private async handleCopy() {
      const rawText = this.textInput?.value || '';
      const textToCopy = applyCaseTransform(rawText, this.currentCase);

      if (!textToCopy) return;

      const success = await copyTextToClipboard(textToCopy);
      if (success && this.copyBtn && this.copyBtnText) {
        this.copyBtn.classList.add('copied');
        this.copyBtnText.textContent = 'Copied ✓';

        setTimeout(() => {
          this.copyBtn?.classList.remove('copied');
          if (this.copyBtnText) this.copyBtnText.textContent = 'Copy Text';
        }, 2200);
      }
    }
  }

  if (!customElements.get('instagram-sans-tool')) {
    customElements.define('instagram-sans-tool', InstagramSansTool);
  }
</script>
