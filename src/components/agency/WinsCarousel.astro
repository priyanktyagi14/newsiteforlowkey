---
import ButtonMask from '../ui/ButtonMask.astro';

const servicePillars = [
  {
    discipline: 'Discipline 01',
    title: 'Web Development & Platforms',
    description: 'High-speed business websites, web applications, and custom e-commerce architectures built on modern edge stacks. Clean, accessible, edge-rendered code that converts visitors and never breaks under load.',
    capabilities: [
      'Custom Web Applications & SaaS Frontends',
      'High-Converting Landing Pages & Portals',
      'Headless E-Commerce (Shopify & Stripe)',
      'Workflow Automation & API Integrations'
    ],
    actionLabel: 'Explore Web Stack',
    link: '/services#web-development'
  },
  {
    discipline: 'Discipline 02',
    title: 'Social Media & Creator Ops',
    description: 'Audience attention is fragmented. We bridge brand objectives with genuine creator relationships, running talent discovery, partnership logistics, and end-to-end content distribution that earns real market share.',
    capabilities: [
      'Comprehensive Social Media Management',
      'Influencer & Creator Discovery',
      'Contract Negotiation & Collaboration Ops',
      'Channel Content Strategy & Trend Surfing'
    ],
    actionLabel: 'Explore Creator Ops',
    link: '/services#social-creator'
  },
  {
    discipline: 'Discipline 03',
    title: 'Creative Production & Brand Identity',
    description: 'We build magnetic visual identities and high-retention video assets that stop the scroll. From comprehensive brand guidelines to daily short-form content, we craft aesthetics people remember.',
    capabilities: [
      'Distinct Brand Identity & Design Systems',
      'Short-Form Video Production (Reels, TikTok, Shorts)',
      'Commercial Video Editing & Post-Production',
      'Creative Direction & Multi-Platform Design'
    ],
    actionLabel: 'Explore Creative',
    link: '/services#creative-production'
  },
  {
    discipline: 'Discipline 04',
    title: 'Digital Growth & Inbound Demand',
    description: 'Engineering without audience is invisible. We install sustainable customer acquisition pipelines through technical SEO, performance marketing, and digital transformation initiatives that compound.',
    capabilities: [
      'Technical & Programmatic SEO',
      'Conversion-Focused Lead Generation',
      'Digital Presence & Authority Management',
      'Business Workflow Digitization'
    ],
    actionLabel: 'Explore Growth',
    link: '/services#digital-growth'
  }
];
---

<section class="wins" id="services" aria-labelledby="wins-heading">
  <!-- Centered Title with Signature Chili Icon -->
  <div class="wins__header site-max">
    <span class="text-12 text-[#ff3831] font-bold block mb-4 tracking-widest uppercase">02 // Core Disciplines</span>
    <h2 id="wins-heading" class="wins__title">
      <span>You win. We grin</span>
      <span class="wins__chili" aria-hidden="true">
        <svg viewBox="0 0 41 54" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
          <path d="M28.8696 28.0488C30.5395 26.3207 32.2966 24.5889 34.6832 23.8524C37.4845 22.9866 40.806 23.68 40.4895 27.1865C40.2785 29.529 37.1425 31.1421 35.6873 32.8487C33.6682 35.2199 32.846 38.6115 30.6923 41.1228C30.3176 41.5576 28.8078 42.8042 28.6659 43.124C28.2912 43.9899 29.4481 47.3958 29.3717 48.6245C29.3026 49.7491 27.7673 51.0353 26.8796 51.6353C22.7541 54.4197 13.5972 54.6065 9.69728 51.3155C7.60179 49.5443 8.33303 48.5311 8.20206 46.1204C8.16932 45.5168 7.98378 44.906 8.03471 44.2845C4.72048 41.6869 2.21024 38.4067 1.10792 34.3181C0.329389 31.4296 -0.107174 26.2093 2.52311 24.1111C2.75595 23.9243 3.50902 23.565 3.54176 23.5183C3.6036 23.4285 3.77459 22.0884 3.94558 21.6465C4.3494 20.6046 5.50265 19.0561 6.71411 18.977L5.03698 16.5663C2.77414 13.0598 1.47536 9.75801 3.13794 5.64071C5.64817 -0.57118 13.4845 -1.7532 17.9228 3.17607C18.152 3.43116 19.0106 4.7533 19.2071 4.70659C19.3089 4.68144 19.68 4.01319 19.8182 3.84073C22.3539 0.761735 25.348 -0.592737 29.4044 0.506649C35.5017 2.15573 37.0625 9.15084 34.6541 14.3603C33.8101 16.1819 32.4385 17.6441 31.4563 19.3399C29.9792 21.8872 29.0224 25.1279 28.866 28.0524L28.8696 28.0488Z" fill="#FF3831"/>
        </svg>
      </span>
      <span>.</span>
    </h2>
  </div>

  <!-- The Signature Smile Arch SVG (Exact Reference Vector Path) -->
  <div class="wins__arch-wrap" aria-hidden="true">
    <svg class="wins__arch" viewBox="-5 -5 1156 389" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
      <path d="M996 108C996 257.117 807.512 378 575 378C342.488 378 154 257.117 154 108" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
      <path d="M1144.66 81.9362C1130.39 121.408 1068.71 135.288 1006.91 112.939C945.103 90.5886 906.572 40.4721 920.846 1" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
      <path d="M1.00002 81.9362C15.2739 121.408 76.948 135.288 138.753 112.939C200.558 90.5886 239.089 40.4721 224.815 1" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
    </svg>
  </div>

  <!-- Horizontal Slider Track -->
  <div class="wins__track" id="wins-track">
    {servicePillars.map(p => (
      <div class="win-card">
        <div>
          <span class="win-card__eyebrow">{p.discipline}</span>
          <h3 class="win-card__title">{p.title}</h3>
          <p class="win-card__body">{p.description}</p>

          <ul class="flex flex-col gap-2 mb-6">
            {p.capabilities.map(cap => (
              <li class="text-sm text-[#fffddb]/80 flex items-center gap-2">
                <span class="text-[#ff3831]">•</span>
                <span>{cap}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <ButtonMask href={p.link} variant="outline">
            <span>{p.actionLabel}</span>
            <span class="btn-mask__icon">→</span>
          </ButtonMask>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  // Enable drag-scroll physics on wins track
  const track = document.getElementById('wins-track');
  let isDown = false;
  let startX = 0;
  let scrollLeft = 0;

  track?.addEventListener('mousedown', (e) => {
    isDown = true;
    startX = e.pageX - track.offsetLeft;
    scrollLeft = track.scrollLeft;
  });

  track?.addEventListener('mouseleave', () => { isDown = false; });
  track?.addEventListener('mouseup', () => { isDown = false; });

  track?.addEventListener('mousemove', (e) => {
    if (!isDown || !track) return;
    e.preventDefault();
    const x = e.pageX - track.offsetLeft;
    const walk = (x - startX) * 1.5;
    track.scrollLeft = scrollLeft - walk;
  });
</script>

