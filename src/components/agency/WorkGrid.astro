---

<section class="work site-max" id="work" aria-labelledby="work-heading">
  <div class="work__header">
    <span class="text-12 text-[#ff3831] font-bold block mb-4 tracking-widest uppercase">01 // Portfolio</span>
    <h2 id="work-heading" class="h1 font-tan">Selected Work</h2>
  </div>

  <div class="work__grid">
    {projects.map((project, index) => (
      <article
        class={`case-item ${project.aspectClass}`}
        data-project-id={project.id}
        tabindex="0"
        role="button"
        aria-label={`View case study for ${project.title}`}
      >
        <div class="case-item__thumbnail radius-fix">
          {project.mediaType === 'video' ? (
            <video
              src={project.mediaSrc}
              class="case-item__media"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            />
          ) : (
            <img
              src={project.mediaSrc}
              alt={project.title}
              class="case-item__media"
              loading="lazy"
            />
          )}
        </div>

        <div class="case-item__meta">
          <h3 class="case-item__title">{project.title}</h3>
          <span class="case-item__tags">{project.tags}</span>
        </div>
      </article>
    ))}
  </div>
</section>

<!-- Pass project data safely to client for the interactive drawer -->
<script define:vars={{ projects }}>
  window.__LOWKEY_PROJECTS = projects;
</script>

