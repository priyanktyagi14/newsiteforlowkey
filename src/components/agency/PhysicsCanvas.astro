---
---

<div class="sf__canvas-wrap" id="physics-wrap" aria-hidden="true">
  <canvas class="sf__canvas" id="physics-canvas"></canvas>
</div>

<script>
  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    rotation: number;
    vRot: number;
    type: 'token' | 'badge';
    badgeText?: string;
    bounciness: number;
  }

  const canvas = document.getElementById('physics-canvas') as HTMLCanvasElement;
  const wrap = document.getElementById('physics-wrap');

  if (canvas && wrap && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d');
    let width = (canvas.width = wrap.clientWidth);
    let height = (canvas.height = wrap.clientHeight);

    window.addEventListener('resize', () => {
      if (!wrap || !canvas) return;
      width = canvas.width = wrap.clientWidth;
      height = canvas.height = wrap.clientHeight;
    });


    const particles: Particle[] = [];
    const gravity = 0.45;
    const friction = 0.985;

    const badges = ['LOWKEY', 'DEV', 'CREATIVE', 'GROWTH', 'EST. 2026', 'EDGE'];

    const spawnParticle = (x?: number, y?: number, forceVy?: number) => {
      const isToken = Math.random() > 0.4;
      const pX = x !== undefined ? x : Math.random() * (width - 60) + 30;
      const pY = y !== undefined ? y : -20 - Math.random() * 100;
      const pVy = forceVy !== undefined ? forceVy : Math.random() * 2 + 1;

      particles.push({
        x: pX,
        y: pY,
        vx: (Math.random() - 0.5) * 6,
        vy: pVy,
        radius: isToken ? 18 : 24,
        rotation: Math.random() * Math.PI * 2,
        vRot: (Math.random() - 0.5) * 0.1,
        type: isToken ? 'token' : 'badge',
        badgeText: isToken ? undefined : badges[Math.floor(Math.random() * badges.length)],
        bounciness: 0.65
      });
    };

    // Initial shower
    for (let i = 0; i < 14; i++) {
      spawnParticle();
    }

    // Expose global spawn method for wordmark click
    (window as any).__spawnTokens = (window as any).__spawnChilis = (count = 10) => {
      for (let i = 0; i < count; i++) {
        spawnParticle(Math.random() * width, -10 - Math.random() * 50, Math.random() * 4 + 2);
      }
    };

    // Mouse impulse physics
    let mouseX = -1000;
    let mouseY = -1000;

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    });

    canvas.addEventListener('mouseleave', () => {
      mouseX = -1000;
      mouseY = -1000;
    });

    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;
      for (let i = 0; i < 6; i++) {
        spawnParticle(clickX + (Math.random() - 0.5) * 40, clickY - 20, -Math.random() * 6 - 2);
      }
    });

    // Mobile touch physics interactions
    canvas.addEventListener('touchstart', (e) => {
      const rect = canvas.getBoundingClientRect();
      const touch = e.touches[0];
      if (touch) {
        const clickX = touch.clientX - rect.left;
        const clickY = touch.clientY - rect.top;
        for (let i = 0; i < 4; i++) {
          spawnParticle(clickX + (Math.random() - 0.5) * 40, clickY - 20, -Math.random() * 5 - 2);
        }
      }
    }, { passive: true });

    canvas.addEventListener('touchmove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const touch = e.touches[0];
      if (touch) {
        mouseX = touch.clientX - rect.left;
        mouseY = touch.clientY - rect.top;
      }
    }, { passive: true });

    canvas.addEventListener('touchend', () => {
      mouseX = -1000;
      mouseY = -1000;
    }, { passive: true });

    // Animation Loop
    let lastTime = performance.now();
    const tick = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const floor = height - 12;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // Apply Gravity
        p.vy += gravity;
        p.x += p.vx;
        p.y += p.vy;
        p.rotation += p.vRot;

        // Friction
        p.vx *= friction;

        // Wall collisions
        if (p.x - p.radius < 0) {
          p.x = p.radius;
          p.vx = -p.vx * p.bounciness;
        } else if (p.x + p.radius > width) {
          p.x = width - p.radius;
          p.vx = -p.vx * p.bounciness;
        }

        // Floor collision
        if (p.y + p.radius >= floor) {
          p.y = floor - p.radius;
          p.vy = -p.vy * p.bounciness;
          p.vx *= 0.94; // Surface traction
          p.vRot *= 0.92;
        }

        // Mouse collision / repulsion
        const dx = p.x - mouseX;
        const dy = p.y - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const touchRadius = p.radius + 60;

        if (dist < touchRadius && dist > 0) {
          const force = (touchRadius - dist) / touchRadius;
          const angle = Math.atan2(dy, dx);
          p.vx += Math.cos(angle) * force * 5;
          p.vy += Math.sin(angle) * force * 5;
          p.vRot += (Math.random() - 0.5) * 0.2;
        }

        // Render Particle
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation);

        if (p.type === 'token') {
          // Electric Violet Circular Token with White LK Geometric Icon
          ctx.fillStyle = '#8C52FF';
          ctx.beginPath();
          ctx.arc(0, 0, p.radius, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
          ctx.lineWidth = 1.5;
          ctx.stroke();

          // Miniature LK Vector Icon
          ctx.fillStyle = '#FFFFFF';
          ctx.save();
          ctx.scale(0.11, 0.11);
          ctx.translate(-100, -75);
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.lineTo(80, 0);
          ctx.lineTo(100, 75);
          ctx.lineTo(120, 150);
          ctx.lineTo(200, 150);
          ctx.lineTo(180, 75);
          ctx.lineTo(100, 75);
          ctx.lineTo(20, 75);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        } else {
          // Sleek Dark Badge Sticker with Lowkeydevs Violet Border
          ctx.fillStyle = '#161622';
          ctx.strokeStyle = '#8C52FF';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(0, 0, p.radius, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#C4A9F3';
          ctx.font = 'bold 9px Poppins, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(p.badgeText || 'LOWKEY', 0, 1);
        }

        ctx.restore();
      }

      requestAnimationFrame(tick);
    };

    tick();
  }
</script>

