---
import ButtonMask from '../ui/ButtonMask.astro';
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <!-- Subtle Atmospheric Vignette -->
  <div class="hero__glow" aria-hidden="true"></div>

  <!-- Screen-Reader Accessibility Shell -->
  <div class="sr-only">
    <h1 id="hero-heading">Lowkeydevs — Multidisciplinary Digital Agency</h1>
    <p>We build web applications, high-converting digital platforms, creative brand campaigns, and creator growth engines for ambitious businesses.</p>
  </div>

  <!-- Studio Eyebrow Pill -->
  <div class="hero__pill" aria-hidden="true">
    <span class="hero__pill-dot"></span>
    <span class="hero__pill-text">Digital Engineering & Creative Agency</span>
  </div>

  <!-- Lowkeydevs Brand Logo with Ambient Glow -->
  <div class="hero__logo-wrap" aria-hidden="true">
    <svg width="56" height="42" viewBox="0 0 200 150" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero__logo-svg">
      <path class="hero__logo-part hero__logo-part--top" fill="#8C52FF" d="M0 0 L80 0 L100 75 L20 75 Z" />
      <path class="hero__logo-part hero__logo-part--bot" fill="#8C52FF" d="M100 75 L180 75 L200 150 L120 150 Z" />
    </svg>
  </div>

  <!-- Main Headline in Authentic TAN MEMORIES Serif with Kinetic Word Animation -->
  <h2 class="hero__tagline">
    Building digital<br />that <span class="hero__rotator" id="hero-rotator">
      <span class="hero__rotator-word is-active" data-index="0">hits hard.</span>
      <span class="hero__rotator-word" data-index="1">scales fast.</span>
      <span class="hero__rotator-word" data-index="2">converts.</span>
      <span class="hero__rotator-word" data-index="3">breaks molds.</span>
      <span class="hero__rotator-word" data-index="4">leaves a mark.</span>
    </span>
  </h2>

  <!-- Signature Lowkeydevs Accent Underline -->
  <div class="hero__swoosh-wrap" aria-hidden="true">
    <svg class="hero__swoosh" viewBox="0 0 120 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 9C38 3 82 3 117 9" stroke="#8C52FF" stroke-width="4.5" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- Editorial Subtitle -->
  <p class="hero__subtitle">
    A multidisciplinary digital agency at the crossroad of software engineering, brand identity, and creator-led distribution.
  </p>

  <!-- Interactive Dual Actions -->
  <div class="hero__actions">
    <ButtonMask href="#work" variant="cream" class="hero__btn hero__btn--primary">
      <span>View Selected Work</span>
      <span class="btn-mask__icon">↓</span>
    </ButtonMask>
    <ButtonMask href="/services" variant="outline" class="hero__btn hero__btn--secondary">
      <span>Our Services</span>
      <span class="btn-mask__icon">→</span>
    </ButtonMask>
  </div>
</section>

<script>
  // Editorial Kinetic Text Rotator
  const rotator = document.getElementById('hero-rotator');
  if (rotator) {
    const words = Array.from(rotator.querySelectorAll('.hero__rotator-word'));
    if (words.length > 1) {
      let activeIndex = 0;
      setInterval(() => {
        const current = words[activeIndex];
        const nextIndex = (activeIndex + 1) % words.length;
        const next = words[nextIndex];

        current.classList.add('is-leaving');
        setTimeout(() => {
          current.classList.remove('is-active', 'is-leaving');
          next.classList.add('is-active');
          activeIndex = nextIndex;
        }, 300);
      }, 3000);
    }
  }
</script>
