---
import PhysicsCanvas from './agency/PhysicsCanvas.astro';
---

<footer class="sf" id="footer" aria-labelledby="footer-manifesto">
  <!-- Interactive Physics Canvas Floor -->
  <PhysicsCanvas />

  <!-- Studio Manifesto in Authentic TAN MEMORIES Serif -->
  <h2 class="sf__manifesto" id="footer-manifesto">
    Lowkeydevs is a multidisciplinary digital agency at the intersection of software engineering, creative direction, and digital growth, shaping brands that move culture and leave a lasting mark.
  </h2>

  <!-- Giant Interactive Wordmark Button (Spawns falling tokens on click) -->
  <button class="sf__wordmark-btn" id="wordmark-btn" type="button" aria-label="Lowkeydevs Interactive Wordmark (Click to spawn tokens)">
    <svg class="sf__wordmark" viewBox="0 0 1000 180" fill="none" xmlns="http://www.w3.org/2000/svg">
      <text
        x="50%"
        y="65%"
        text-anchor="middle"
        dominant-baseline="central"
        fill="currentColor"
        font-family="'Poppins', system-ui, sans-serif"
        font-weight="800"
        font-size="120"
        letter-spacing="0.04em"
      >
        LOWKEYDEVS
      </text>
    </svg>
  </button>

  <!-- Bottom Meta Information Row -->
  <div class="site-max">
    <div class="sf__meta">
      <div class="sf__meta-text">
        <p>Partnering with ambitious founders, brands & inspiring creators worldwide.</p>
        <p class="text-xs text-white/40 mt-1">© 2026 Lowkeydevs Inc. All rights reserved.</p>
      </div>

      <div class="sf__meta-links">
        <a href="mailto:hello@lowkeydevs.com" class="sf__meta-link">hello@lowkeydevs.com</a>
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="sf__meta-link">Instagram</a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="sf__meta-link">LinkedIn</a>
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="sf__meta-link">X (Twitter)</a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="sf__meta-link">GitHub</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Wordmark click interactive trigger
  const wordmarkBtn = document.getElementById('wordmark-btn');
  wordmarkBtn?.addEventListener('click', () => {
    if (typeof (window as any).__spawnTokens === 'function') {
      (window as any).__spawnTokens(14);
    } else if (typeof (window as any).__spawnChilis === 'function') {
      (window as any).__spawnChilis(14);
    }
  });
</script>
