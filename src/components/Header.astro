---
import ButtonMask from './ui/ButtonMask.astro';
---

<header class="sh" id="site-header">
  <!-- Pinned Top-Left Brand Mark Box -->
  <a href="/" class="sh__box" aria-label="Lowkeydevs Home">
    <svg class="w-24 h-24" width="28" height="28" viewBox="0 0 41 54" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M28.8696 28.0488C30.5395 26.3207 32.2966 24.5889 34.6832 23.8524C37.4845 22.9866 40.806 23.68 40.4895 27.1865C40.2785 29.529 37.1425 31.1421 35.6873 32.8487C33.6682 35.2199 32.846 38.6115 30.6923 41.1228C30.3176 41.5576 28.8078 42.8042 28.6659 43.124C28.2912 43.9899 29.4481 47.3958 29.3717 48.6245C29.3026 49.7491 27.7673 51.0353 26.8796 51.6353C22.7541 54.4197 13.5972 54.6065 9.69728 51.3155C7.60179 49.5443 8.33303 48.5311 8.20206 46.1204C8.16932 45.5168 7.98378 44.906 8.03471 44.2845C4.72048 41.6869 2.21024 38.4067 1.10792 34.3181C0.329389 31.4296 -0.107174 26.2093 2.52311 24.1111C2.75595 23.9243 3.50902 23.565 3.54176 23.5183C3.6036 23.4285 3.77459 22.0884 3.94558 21.6465C4.3494 20.6046 5.50265 19.0561 6.71411 18.977L5.03698 16.5663C2.77414 13.0598 1.47536 9.75801 3.13794 5.64071C5.64817 -0.57118 13.4845 -1.7532 17.9228 3.17607C18.152 3.43116 19.0106 4.7533 19.2071 4.70659C19.3089 4.68144 19.68 4.01319 19.8182 3.84073C22.3539 0.761735 25.348 -0.592737 29.4044 0.506649C35.5017 2.15573 37.0625 9.15084 34.6541 14.3603C33.8101 16.1819 32.4385 17.6441 31.4563 19.3399C29.9792 21.8872 29.0224 25.1279 28.866 28.0524L28.8696 28.0488Z" fill="#FFFEDB" />
    </svg>
  </a>

  <!-- Scrolled Sticky Dropdown Navigation Capsule -->
  <nav class="sh__nav" id="sticky-nav" aria-label="Main Navigation">
    <a href="#work" class="sh__link">Selected Work</a>
    
    <div class="sh__services-group">
      <button class="sh__link sh__services-toggle" id="services-toggle" type="button" aria-expanded="false">
        <span>Services</span>
        <svg class="sh__chevron" id="services-chevron" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="sh__subnav" id="services-subnav">
        <a href="/services#web-development" class="sh__sublink">Web Development</a>
        <a href="/services#social-creator" class="sh__sublink">Social & Creators</a>
        <a href="/services#creative-production" class="sh__sublink">Creative & Brand</a>
        <a href="/services#digital-growth" class="sh__sublink">Digital Growth</a>
      </div>
    </div>

    <a href="/agency" class="sh__link">Agency</a>
    <a href="/agency#process" class="sh__link">Process</a>
    <a href="/contact" class="sh__link">Contact</a>
  </nav>

  <!-- Pinned Top-Right Action -->
  <div class="sh-right">
    <ButtonMask href="/contact" variant="cream" class="hidden s:inline-flex">
      <span>Start a Project</span>
      <span class="btn-mask__icon">→</span>
    </ButtonMask>

    <!-- Mobile Menu Button -->
    <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Fullscreen Mobile Navigation Drawer -->
  <div class="mm" id="mobile-menu" aria-hidden="true">
    <div class="flex justify-between items-center">
      <a href="/" class="font-tan text-3xl text-[#fffddb]">Lowkeydevs</a>
      <button class="text-2xl text-[#ff3831] p-2" id="mobile-close" aria-label="Close menu">✕</button>
    </div>

    <nav class="mm__links">
      <a href="#work" class="mm__link">Selected Work</a>
      <a href="/services" class="mm__link">Services</a>
      <a href="/agency" class="mm__link">Agency</a>
      <a href="/agency#process" class="mm__link">Process</a>
      <a href="/contact" class="mm__link text-[#ff3831]">Start a Project →</a>
    </nav>

    <div class="flex flex-col gap-2 pt-6 border-t border-white/10">
      <span class="text-sm text-white/50 uppercase tracking-widest">Inquiries</span>
      <a href="mailto:hello@lowkeydevs.com" class="text-lg text-[#fffddb]">hello@lowkeydevs.com</a>
    </div>
  </div>
</header>

<script>
  // Handle Sticky Nav Scroll State
  const header = document.getElementById('site-header');
  const servicesToggle = document.getElementById('services-toggle');
  const servicesSubnav = document.getElementById('services-subnav');
  const servicesChevron = document.getElementById('services-chevron');
  const mobileToggle = document.getElementById('mobile-toggle');
  const mobileClose = document.getElementById('mobile-close');
  const mobileMenu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (window.scrollY > 150) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Accordion Toggle
  servicesToggle?.addEventListener('click', () => {
    const isOpen = servicesSubnav?.classList.toggle('is-open');
    if (servicesChevron) {
      servicesChevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    servicesToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  // Mobile Drawer Toggle
  mobileToggle?.addEventListener('click', () => {
    mobileMenu?.classList.add('is-open');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  });

  const closeMobile = () => {
    mobileMenu?.classList.remove('is-open');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  mobileClose?.addEventListener('click', closeMobile);
  document.querySelectorAll('.mm__link').forEach(link => {
    link.addEventListener('click', closeMobile);
  });
</script>
