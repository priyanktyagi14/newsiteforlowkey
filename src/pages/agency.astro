---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ButtonMask from '../components/ui/ButtonMask.astro';
import MetricsTicker from '../components/agency/MetricsTicker.astro';
import TestimonialDeck from '../components/agency/TestimonialDeck.astro';

const principles = [
  {
    num: '01',
    title: 'Builders Over Bureaucracy',
    body: 'We eliminated account managers and endless status meetings. When you partner with Lowkeydevs, you talk directly with the engineers, designers, and growth strategists executing your project.'
  },
  {
    num: '02',
    title: 'Output Is The Only Honest Metric',
    body: 'Agencies love billable hours; we love shipped outcomes. We measure our engagements by functional software deployed, content reaching audiences, and conversion pipelines live.'
  },
  {
    num: '03',
    title: 'Zero Generic Templates',
    body: 'Cookie-cutter themes and generic AI copy dilute your brand authority. Every web application, short-form video, and visual identity we produce is custom-tailored to your unique market positioning.'
  },
  {
    num: '04',
    title: 'Built For Day One Thousand',
    body: 'We don’t cut corners that cause technical debt six months later. Whether it’s edge database rules or modular motion assets, our work scales seamlessly with your business.'
  }
];

const processSteps = [
  {
    step: 'Phase 01',
    title: 'Discover & Map',
    description: 'We audit your current technical architecture, competitive positioning, and audience landscape. We define clear delivery milestones, core KPIs, and technical specifications before writing a single line of code.'
  },
  {
    step: 'Phase 02',
    title: 'Design & Build',
    description: 'Rapid sprint execution. We design tactile brand assets, engineer edge-native web applications, produce high-retention video reels, and initiate creator outreach workflows in tight feedback loops.'
  },
  {
    step: 'Phase 03',
    title: 'Deploy & Scale',
    description: 'Production release across global edge networks. We verify technical SEO, launch multi-channel creator distribution, and monitor lead conversion telemetry to continuously compound your digital advantage.'
  }
];
---

<Layout
  title="The Agency — Lowkeydevs"
  description="Learn about Lowkeydevs: our operating principles, studio ethos, and disciplined sprint process."
>
  <Header />

  <main id="main-content">
    <!-- Agency Hero -->
    <section class="services-hero site-max">
      <span class="services-hero__kicker">The Studio</span>
      <h1 class="services-hero__title">Lowkey presence.<br/>High-impact output.</h1>
      <p class="services-hero__lead">
        Most digital agencies are loud on self-promotion and fragile on execution. We operate with deliberate understatement—letting the performance of our software, brand craft, and client growth speak for itself.
      </p>
      <div class="services-nav">
        <ButtonMask href="/contact" variant="red">
          <span>Start a Project</span>
          <span class="btn-mask__icon">→</span>
        </ButtonMask>
        <ButtonMask href="#principles" variant="outline">
          <span>Our Principles</span>
          <span class="btn-mask__icon">↓</span>
        </ButtonMask>
      </div>
    </section>

    <!-- Metrics Ticker -->
    <MetricsTicker />

    <!-- Principles Matrix -->
    <section id="principles" class="site-max editorial-section">
      <div class="faq-header">
        <span class="services-hero__kicker">Core Values</span>
        <h2 class="h2 font-tan text-center">The Lowkey Standard</h2>
      </div>

      <div class="capability-grid" style="margin-top: 6rem;">
        {principles.map(p => (
          <div class="capability-card">
            <div>
              <span class="font-tan text-4xl" style="font-size: 3.5rem; color: var(--color-accent-red); display: block; margin-bottom: 1.5rem;">{p.num}</span>
              <h3 class="capability-card__title" style="font-size: 2.2rem; margin-bottom: 1.5rem;">{p.title}</h3>
              <p class="capability-card__desc" style="font-size: 1.6rem; line-height: 1.6;">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- The 3-Step Process -->
    <section id="process" class="process-section site-max">
      <div class="process-section__header">
        <span class="services-hero__kicker">Our Methodology</span>
        <h2 class="h2 font-tan text-center">How We Execute</h2>
      </div>

      <div class="process-grid">
        {processSteps.map((step) => (
          <div class="process-card">
            <span class="process-card__tag">{step.step}</span>
            <h3 class="process-card__title">{step.title}</h3>
            <p class="process-card__desc">{step.description}</p>
          </div>
        ))}
      </div>

      <div style="text-align: center; margin-top: 6rem;">
        <ButtonMask href="/contact" variant="red">
          <span>Start a Sprint With Us</span>
          <span class="btn-mask__icon">→</span>
        </ButtonMask>
      </div>
    </section>

    <!-- Testimonial Deck -->
    <TestimonialDeck />
  </main>

  <Footer />
</Layout>
