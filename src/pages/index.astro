---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/agency/HeroSection.astro';
import MetricsTicker from '../components/agency/MetricsTicker.astro';
import WorkGrid from '../components/agency/WorkGrid.astro';
import CaseStudyDrawer from '../components/agency/CaseStudyDrawer.astro';
import WinsCarousel from '../components/agency/WinsCarousel.astro';
import ClientMatrix from '../components/agency/ClientMatrix.astro';
import TestimonialDeck from '../components/agency/TestimonialDeck.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Lowkeydevs — Multidisciplinary Digital Agency"
  description="A multidisciplinary digital agency at the crossroad of software engineering, brand identity, and creator-led distribution."
>
  <!-- Global Navigation & Two-Stage Sticky Header -->
  <Header />

  <main id="main-content">
    <!-- Section 01: Hero & Tagline -->
    <HeroSection />

    <!-- Section 02: Execution Standards & Capability Ticker -->
    <MetricsTicker />

    <!-- Section 03: Selected Work (3-Column Asymmetric Masonry) -->
    <WorkGrid />

    <!-- Section 04: Disciplines & Services Deep-Dive ("You win. We grin.") -->
    <WinsCarousel />

    <!-- Section 05: Technology Ecosystem & Platform Matrix -->
    <ClientMatrix />

    <!-- Section 06: "The Lowkey Standard" Operating Principles Deck -->
    <TestimonialDeck />
  </main>

  <!-- Interactive Slide-Out Case Study Dossier -->
  <CaseStudyDrawer />

  <!-- Section 07: Studio Manifesto & Interactive Physics Footer -->
  <Footer />
</Layout>
