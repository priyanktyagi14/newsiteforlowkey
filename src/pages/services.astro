---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ButtonMask from '../components/ui/ButtonMask.astro';
import MetricsTicker from '../components/agency/MetricsTicker.astro';
import TestimonialDeck from '../components/agency/TestimonialDeck.astro';
import { servicesData } from '../data/services';

const masterFaqs = [
  {
    q: 'Can Lowkeydevs support branding, web design, development, and creator distribution in one project?',
    a: 'Yes. Our four core disciplines are tightly integrated. Rather than juggling disconnected contractors and agencies, you get one unified sprint team where system architecture, brand design, video content, and conversion engineering work in continuous harmony.'
  },
  {
    q: 'How fast can we launch a sprint engagement?',
    a: 'Our standard sprint cycles run 2 to 4 weeks depending on the discipline and deliverables. We formulate clear milestones upfront, lock scope, and start shipping immediately—no bureaucratic delays.'
  },
  {
    q: 'Do you work on fixed-price sprints or monthly retainers?',
    a: 'We offer both. Brand identity sprints, platform builds, and web applications are typically structured as fixed-price sprints. Ongoing creator distribution, social stewardship, and growth engineering operate on flexible monthly retainers.'
  },
  {
    q: 'Who owns the intellectual property and code repositories?',
    a: 'You do. 100% of the code repositories, Figma design tokens, raw 4K video footage, and digital deliverables belong to your business outright upon milestone settlement.'
  },
  {
    q: 'How do you communicate during an active sprint?',
    a: 'We set up a private Slack or Discord channel with your core stakeholders and deliver async Loom video walk-throughs twice a week. You speak directly with the builders executing the work.'
  }
];
---

<Layout
  title="Capabilities & Services — Lowkeydevs"
  description="Explore Lowkeydevs' core disciplines: Web Development & Platforms, Social Media & Creator Management, Creative Production, and Digital Growth."
>
  <Header />

  <main id="main-content">
    <!-- Services Page Hero -->
    <section class="services-hero site-max">
      <span class="services-hero__kicker">Our Capabilities</span>
      <h1 class="services-hero__title">We know what we're good at!</h1>
      <p class="services-hero__lead">
        Four focused disciplines engineered to deliver unfair advantages for ambitious brands, founders, and modern creators.
      </p>

      <!-- Quick Jump Discipline Navigation -->
      <nav class="services-nav" aria-label="Discipline Quick Links">
        {servicesData.map(s => (
          <a href={`#${s.id}`} class="services-nav__pill">
            <span class="services-nav__num">{s.number}</span>
            <span>{s.shortTitle}</span>
          </a>
        ))}
      </nav>
    </section>

    <!-- Metrics Ticker Bar -->
    <MetricsTicker />

    <!-- 4 Disciplines Deep Dive -->
    <div class="site-max">
      {servicesData.map(s => (
        <section id={s.id} class="service-discipline" aria-labelledby={`heading-${s.id}`}>
          <div class="service-discipline__grid">
            <!-- Left Sticky Sidebar -->
            <div class="service-discipline__sidebar">
              <span class="service-discipline__kicker">{s.discipline}</span>
              <h2 id={`heading-${s.id}`} class="service-discipline__title">{s.title}</h2>
              <p class="service-discipline__desc">{s.lead}</p>
              
              <div class="service-discipline__actions">
                <ButtonMask href={`/services/${s.slug}`} variant="cream">
                  <span>Explore Discipline</span>
                  <span class="btn-mask__icon">→</span>
                </ButtonMask>
                <ButtonMask href={`/contact?service=${s.slug}`} variant="outline">
                  <span>Inquire Now</span>
                  <span class="btn-mask__icon">→</span>
                </ButtonMask>
              </div>
            </div>

            <!-- Right Capabilities Grid -->
            <div class="capability-grid">
              {s.capabilities.map(cap => (
                <article class="capability-card">
                  <div>
                    <h3 class="capability-card__title">{cap.name}</h3>
                    <p class="capability-card__desc">{cap.desc}</p>
                  </div>
                  {cap.deliverables && cap.deliverables.length > 0 && (
                    <div class="capability-card__tags">
                      {cap.deliverables.map(tag => (
                        <span class="capability-card__tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Client Testimonials ("Client Confessions") -->
    <TestimonialDeck />

    <!-- FAQ Accordion -->
    <section class="site-max">
      <div class="faq-wrap">
        <div class="faq-header">
          <span class="services-hero__kicker">Frequently Asked Questions</span>
          <h2 class="h2 font-tan text-center">Clear answers upfront.</h2>
        </div>

        <div class="faq-list">
          {masterFaqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-summary">
                <span class="faq-question">{faq.q}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <p class="faq-content">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Services Bottom CTA Banner -->
    <section class="site-max">
      <div class="services-cta-banner">
        <span class="services-hero__kicker">Ready To Ship</span>
        <h2 class="services-cta-banner__title">Let's build your advantage.</h2>
        <p class="services-cta-banner__lead">
          Tell us about your brand, your timeline, and the disciplines you need. We review every project brief and respond within 24 business hours.
        </p>
        <div class="services-cta-banner__actions">
          <ButtonMask href="/contact" variant="red">
            <span>Start a Project</span>
            <span class="btn-mask__icon">→</span>
          </ButtonMask>
          <ButtonMask href="/agency" variant="outline">
            <span>About The Studio</span>
            <span class="btn-mask__icon">→</span>
          </ButtonMask>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
