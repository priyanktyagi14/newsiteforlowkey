---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ButtonMask from '../components/ui/ButtonMask.astro';
---

<Layout
  title="Start a Project — Lowkeydevs"
  description="Consult with Lowkeydevs on web engineering, creator campaigns, brand systems, or digital growth."
>
  <Header />

  <main id="main-content">
    <!-- Contact Hero -->
    <section class="services-hero site-max">
      <span class="services-hero__kicker">Start An Engagement</span>
      <h1 class="services-hero__title">Let's build something exceptional.</h1>
      <p class="services-hero__lead">
        Tell us about your brand, your timeline, and the disciplines you need. We review every brief and respond within 24 business hours.
      </p>
    </section>

    <!-- Inbound Consultation Form Card -->
    <div class="site-max contact-wrap">
      <form id="contact-form" class="contact-card">
        <div class="form-grid-2">
          <div class="form-group">
            <label for="name" class="form-label">Your Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Alex Vance"
              class="form-input"
            />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Work Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="alex@company.com"
              class="form-input"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="company" class="form-label">Company / Brand Name</label>
          <input
            type="text"
            id="company"
            name="company"
            placeholder="e.g. Acme Corp"
            class="form-input"
          />
        </div>

        <!-- Discipline Selection Pills -->
        <div class="form-group">
          <span class="form-label">Disciplines Needed</span>
          <div class="form-pill-group">
            {[
              'Web Development',
              'Social & Creator Management',
              'Creative Production & Brand',
              'Digital Growth & SEO'
            ].map(disc => (
              <label class="form-pill-label">
                <input type="checkbox" name="services" value={disc} class="sr-only" />
                <span>{disc}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Budget Range Selection -->
        <div class="form-group">
          <span class="form-label">Estimated Project Budget</span>
          <div class="form-pill-group">
            {['$5,000 – $10,000', '$10,000 – $25,000', '$25,000+'].map((b, idx) => (
              <label class="form-pill-label --radio">
                <input type="radio" name="budget" value={b} class="sr-only" checked={idx === 1} />
                <span>{b}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Brief Details -->
        <div class="form-group">
          <label for="brief" class="form-label">Project Brief & Objectives *</label>
          <textarea
            id="brief"
            name="brief"
            required
            rows="5"
            placeholder="Tell us about what you want to build, key goals, target audience, and desired launch timeline..."
            class="form-textarea"
          ></textarea>
        </div>

        <!-- Submission Status Message -->
        <div id="form-feedback" class="hidden" style="padding: 1.5rem; border-radius: 0.5rem; text-align: center; font-size: 1.5rem;"></div>

        <div class="form-footer">
          <span class="form-confidential">🔒 Your information is confidential.</span>
          <ButtonMask type="submit" variant="red" id="submit-btn">
            <span>Send Project Brief</span>
            <span class="btn-mask__icon">→</span>
          </ButtonMask>
        </div>
      </form>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn');

  // Pre-select service checkbox if query param matches
  const params = new URLSearchParams(window.location.search);
  const serviceQuery = params.get('service');
  if (serviceQuery) {
    const slugToService: Record<string, string> = {
      'web-development': 'Web Development',
      'social-creator': 'Social & Creator Management',
      'creative-production': 'Creative Production & Brand',
      'digital-growth': 'Digital Growth & SEO'
    };
    const targetName = slugToService[serviceQuery];
    if (targetName) {
      const checkbox = form?.querySelector(`input[name="services"][value="${targetName}"]`) as HTMLInputElement;
      if (checkbox) checkbox.checked = true;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.style.opacity = '0.5';
    }

    const formData = new FormData(form);
    const services = formData.getAll('services');
    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      company: formData.get('company'),
      services: services,
      budget: formData.get('budget'),
      brief: formData.get('brief')
    };

    try {
      const res = await fetch('/api/inquiries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (feedback) {
        feedback.style.display = 'block';
        if (data.success) {
          feedback.style.backgroundColor = 'rgba(16, 185, 129, 0.15)';
          feedback.style.color = '#a7f3d0';
          feedback.style.border = '1px solid rgba(16, 185, 129, 0.3)';
          feedback.textContent = data.message;
          form.reset();
        } else {
          feedback.style.backgroundColor = 'rgba(239, 68, 68, 0.15)';
          feedback.style.color = '#fca5a5';
          feedback.style.border = '1px solid rgba(239, 68, 68, 0.3)';
          feedback.textContent = data.message || 'Error sending inquiry. Please try again.';
        }
      }
    } catch (err) {
      if (feedback) {
        feedback.style.display = 'block';
        feedback.style.backgroundColor = 'rgba(239, 68, 68, 0.15)';
        feedback.style.color = '#fca5a5';
        feedback.style.border = '1px solid rgba(239, 68, 68, 0.3)';
        feedback.textContent = 'Network error. Please try again or email hello@lowkeydevs.com.';
      }
    } finally {
      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.style.opacity = '1';
      }
    }
  });
</script>
